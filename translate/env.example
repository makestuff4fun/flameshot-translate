# flameshot-translate settings. install.sh copies this to
# ~/.config/flameshot-translate/.env (mode 600) if that file does not exist.
# Variables already set in the environment override this file.

# Any OpenAI-compatible /chat/completions endpoint.
FLAMESHOT_TRANSLATE_API_BASE=https://api.deepseek.com/v1
FLAMESHOT_TRANSLATE_API_KEY=
FLAMESHOT_TRANSLATE_MODEL=deepseek-flash
# reasoning_effort sent to the API: low | high | max. Empty = don't send it.
FLAMESHOT_TRANSLATE_EFFORT=low
FLAMESHOT_TRANSLATE_TIMEOUT=60
